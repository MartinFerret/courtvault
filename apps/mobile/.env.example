# Mobile app (Angular + Ionic + Capacitor). Values are copied into src/environments at build time.
# The anon key is public by design; Row Level Security protects the data.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
# RevenueCat public SDK keys (not the secret API key). Empty = billing runs in mock mode.
REVENUECAT_APPLE_KEY=
REVENUECAT_GOOGLE_KEY=
# Google OAuth web client id used by Supabase Auth. Empty = Google sign-in disabled.
GOOGLE_WEB_CLIENT_ID=
# Website origin for deep links.
WEB_URL=http://localhost:3000
