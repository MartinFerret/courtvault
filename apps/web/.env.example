# Website (Next.js on Netlify). Only public data is read, with the anon key, on the server.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Canonical origin, used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Apple App Store id for the iOS smart app banner. Leave empty until the app is published.
NEXT_PUBLIC_APPLE_APP_ID=
# Secret shared with the database/edge functions to call /api/revalidate (on-demand ISR).
REVALIDATE_SECRET=change-me
# PostHog (EU project). Public project token; empty = analytics off (local dev). Events go through /ingest.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
