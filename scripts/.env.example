# Scripts (checklist import, job runner, usage report). Run locally or from CI.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Shared secret that job functions expect (same as JOB_SECRET in supabase/functions/.env).
JOB_SECRET=local-job-secret
# Dev only: lower the free card limit to test the paywall.
FREE_CARD_LIMIT_OVERRIDE=
