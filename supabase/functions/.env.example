# Edge functions. Loaded by `supabase functions serve --env-file supabase/functions/.env`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically
# by the Supabase runtime (local and cloud). Never ship the service role key to a client.

# Providers: mock mode needs no key.
STATS_PROVIDER=mock        # mock | highlightly
PRICE_PROVIDER=mock        # mock | ebay
PUSH_PROVIDER=log          # log | fcm

# Highlightly (https://nba.highlightly.net, free plan: 100 requests/day)
HIGHLIGHTLY_API_KEY=

# eBay Browse API (OAuth client credentials, marketplace EBAY_US). Active listings = asking prices.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay Partner Network campaign id. Optional: buy links are plain when empty.
EBAY_AFFILIATE_CAMPAIGN_ID=

# Email (morning digest). log = print only. Brevo free plan: 300 emails/day shared with auth SMTP.
EMAIL_PROVIDER=log         # log | brevo
BREVO_API_KEY=
EMAIL_FROM=Hoopfolio <hello@hoopfolio.app>
# Digest emails per run (keeps room for login codes under the daily plan limit).
EMAIL_DAILY_BUDGET=220
# Postal address printed in every email footer (US CAN-SPAM). Placeholder until Martin's details.
EMAIL_POSTAL_ADDRESS=Hoopfolio, address to be confirmed
# Public origins used in email links.
SITE_URL=https://hoopfolio.app
WEB_APP_URL=https://vault.hoopfolio.app

# Stripe (web checkout). Test keys first. Price ids must carry the amounts of PRICING (packages/shared).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_LIFETIME=

# RevenueCat webhook: the value RevenueCat sends in the Authorization header.
REVENUECAT_WEBHOOK_SECRET=change-me

# Firebase Cloud Messaging (HTTP v1, service account). Only used when PUSH_PROVIDER=fcm.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Website on-demand revalidation (optional). When set, jobs ping the website after price updates.
WEB_REVALIDATE_URL=
WEB_REVALIDATE_SECRET=

# Shared secret that pg_cron sends when invoking job functions. Must match the database setting.
JOB_SECRET=local-job-secret

# Dev only: lower the free card limit to test the paywall quickly (applied by `pnpm db:reset`).
FREE_CARD_LIMIT_OVERRIDE=
